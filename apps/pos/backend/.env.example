NODE_ENV=production
PORT=5000

# ── Database ───────────────────────────────────────────────────────────────────
# In production, set DATABASE_URL to the RDS Postgres endpoint.
# Leave DATABASE_URL unset for docker-compose / local dev — the DB_* vars
# below are used instead (docker-compose.yml overrides DB_HOST to "postgres").
# DATABASE_URL=postgresql://user:password@host:5432/database

DB_HOST=localhost
DB_PORT=5432
DB_NAME=retail_pos
DB_USER=postgres
DB_PASSWORD=postgres

# ── Auth ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=8h

# ── CORS (optional) ────────────────────────────────────────────────────────────
# Only set when the frontend lives on a different domain than the backend.
# FRONTEND_URL=https://app.yourdomain.com

# ── Internal service-to-service (apps/admin-dashboard/backend) ───────────────
# Guards POST /api/tenants/provision — admin-dashboard/backend calls this
# when an agent provisions an online customer. Must match the same value in
# apps/admin-dashboard/backend/.env.
INTERNAL_API_KEY=change_this_to_a_long_random_secret

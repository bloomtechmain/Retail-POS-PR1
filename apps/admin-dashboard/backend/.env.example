NODE_ENV=production
PORT=5001

# ── Database (SAME Postgres database as apps/pos/backend) ────────────────────
# In production, point DATABASE_URL at the same RDS instance apps/pos/backend uses.
# Leave DATABASE_URL unset for docker-compose / local dev — see apps/pos/backend/.env.example.
# DATABASE_URL=postgresql://user:password@host:5432/database

DB_HOST=localhost
DB_PORT=5432
DB_NAME=retail_pos
DB_USER=postgres
DB_PASSWORD=postgres

# ── Auth (own secret — separate from apps/pos/backend's tenant-user JWTs) ────
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=8h

# ── CORS (optional) ────────────────────────────────────────────────────────────
# FRONTEND_URL=https://dashboard.yourdomain.com

# ── apps/pos/backend (tenant provisioning + plan catalog) ─────────────────────
POS_BACKEND_URL=http://pos-backend:5000
# Must match INTERNAL_API_KEY in apps/pos/backend/.env
INTERNAL_API_KEY=change_this_to_a_long_random_secret

# ── apps/license-server (offline/Electron customer provisioning) ─────────────
LICENSE_SERVER_URL=http://license-server:3001
LICENSE_SERVER_ADMIN_USERNAME=admin
LICENSE_SERVER_ADMIN_PASSWORD=change_this_password

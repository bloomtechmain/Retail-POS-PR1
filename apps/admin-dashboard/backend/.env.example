NODE_ENV=production
PORT=5001

# ── Database (SAME Postgres database as apps/pos/backend) ────────────────────
# On Railway: point this at the same PostgreSQL service apps/pos/backend uses.
DATABASE_URL=postgresql://user:password@host:5432/database

# Local dev (used only when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=retail_pos
DB_USER=postgres
DB_PASSWORD=yourpassword

# ── Auth (own secret — separate from apps/pos/backend's tenant-user JWTs) ────
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=8h

# ── CORS (optional) ────────────────────────────────────────────────────────────
# FRONTEND_URL=https://your-admin-dashboard.up.railway.app

# ── apps/pos/backend (tenant provisioning + plan catalog) ─────────────────────
POS_BACKEND_URL=https://your-pos-backend.up.railway.app
# Must match INTERNAL_API_KEY in apps/pos/backend/.env
INTERNAL_API_KEY=change_this_to_a_long_random_secret

# ── apps/license-server (offline/Electron customer provisioning) ─────────────
LICENSE_SERVER_URL=https://your-license-server.up.railway.app
LICENSE_SERVER_ADMIN_USERNAME=admin
LICENSE_SERVER_ADMIN_PASSWORD=change_this_password
